---
import { site } from '../../config/site';
import { es } from '../../content/es';
import { en } from '../../content/en';
---
<section id="contacto" class="section scroll-mt relative">
  <div class="container-x relative z-10">
    <div class="max-w-3xl">
      <p class="text-xs uppercase tracking-[0.22em] text-gold-400 font-semibold">
        <span data-lang-only="es">{es.ui.sections.contactEyebrow}</span>
        <span data-lang-only="en">{en.ui.sections.contactEyebrow}</span>
      </p>
      <h2 class="mt-2 text-3xl md:text-5xl font-bold tracking-tight">
        <span data-lang-only="es">{es.ui.sections.contactTitle}</span>
        <span data-lang-only="en">{en.ui.sections.contactTitle}</span>
      </h2>
      <p class="mt-4 text-white/75 max-w-2xl">
        <span data-lang-only="es">Disponible para asesorías especializadas, dirección de operaciones, administración general de contratos y proyectos de logística minera en Chile.</span>
        <span data-lang-only="en">Available for specialized advisory, operations leadership, general contract administration and mining logistics projects in Chile.</span>
      </p>
    </div>

    <div class="mt-10 flex flex-wrap gap-3">
      <a href={`mailto:${site.email}`} class="btn-primary btn-contact-glow">
        <span data-lang-only="es">{es.ui.cta.contact}</span>
        <span data-lang-only="en">{en.ui.cta.contact}</span>
      </a>
      <a href={site.whatsappUrl} target="_blank" rel="noopener" class="btn-outline">
        <span data-lang-only="es">{es.ui.cta.whatsapp}</span>
        <span data-lang-only="en">{en.ui.cta.whatsapp}</span>
      </a>
    </div>

    <div class="mt-8 glass rounded-2xl p-6 md:p-7">
      <p class="eyebrow">
        <span data-lang-only="es">{es.reader.availabilityTitle}</span>
        <span data-lang-only="en">{en.reader.availabilityTitle}</span>
      </p>
      <p class="mt-3 max-w-3xl text-sm md:text-base text-body leading-relaxed">
        <span data-lang-only="es">{es.reader.availabilityIntro}</span>
        <span data-lang-only="en">{en.reader.availabilityIntro}</span>
      </p>
      <div class="mt-6 grid md:grid-cols-2 gap-3">
        {es.reader.availabilityItems.map((item, i) => (
          <article class="surface rounded-2xl p-4">
            <p class="text-xs uppercase tracking-[0.18em] text-gold-400 font-semibold">
              <span data-lang-only="es">{item.title}</span>
              <span data-lang-only="en">{en.reader.availabilityItems[i].title}</span>
            </p>
            <p class="mt-2 text-sm text-body leading-relaxed">
              <span data-lang-only="es">{item.detail}</span>
              <span data-lang-only="en">{en.reader.availabilityItems[i].detail}</span>
            </p>
          </article>
        ))}
      </div>
    </div>

    <div class="mt-10 grid md:grid-cols-2 lg:grid-cols-4 gap-3">
      <a href={`mailto:${site.email}`} class="glass rounded-2xl p-5 hover:bg-white/15 transition group">
        <p class="text-xs uppercase tracking-widest text-gold-400">Email</p>
        <p class="mt-2 text-white font-semibold break-all">{site.email}</p>
      </a>
      <a href={`tel:${site.phoneRaw}`} class="glass rounded-2xl p-5 hover:bg-white/15 transition">
        <p class="text-xs uppercase tracking-widest text-gold-400">
          <span data-lang-only="es">Teléfono</span>
          <span data-lang-only="en">Phone</span>
        </p>
        <p class="mt-2 text-white font-semibold">{site.phone}</p>
      </a>
      <a href={site.whatsappUrl} target="_blank" rel="noopener" class="glass rounded-2xl p-5 hover:bg-white/15 transition">
        <p class="text-xs uppercase tracking-widest text-gold-400">WhatsApp</p>
        <p class="mt-2 text-white font-semibold">{site.phone}</p>
      </a>
      <a href={site.linkedinUrl} target="_blank" rel="noopener" class="glass rounded-2xl p-5 hover:bg-white/15 transition">
        <p class="text-xs uppercase tracking-widest text-gold-400">LinkedIn</p>
        <p class="mt-2 text-white font-semibold">
          <span data-lang-only="es">Perfil profesional</span>
          <span data-lang-only="en">Professional profile</span>
        </p>
      </a>
    </div>

    <div class="mt-8 flex flex-wrap items-center gap-3 text-xs text-white/55">
      <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-exec-green/15 border border-exec-green/30 text-exec-green font-medium">
        <span class="h-1.5 w-1.5 rounded-full bg-exec-green animate-pulse"></span>
        <span data-lang-only="es">{es.ui.labels.availability}</span>
        <span data-lang-only="en">{en.ui.labels.availability}</span>
      </span>
      <span>
        <span data-lang-only="es">{es.ui.labels.references}</span>
        <span data-lang-only="en">{en.ui.labels.references}</span>
      </span>
    </div>
  </div>
</section>
