---
import { site } from '../../config/site';
import { es } from '../../content/es';
import { en } from '../../content/en';
---
<section id="cv" class="section scroll-mt relative">
  <div class="container-x relative z-10">
    <header class="max-w-3xl">
      <p class="eyebrow">
        <span data-lang-only="es">Documento</span>
        <span data-lang-only="en">Document</span>
      </p>
      <h2 class="section-title mt-2">
        <span data-lang-only="es">Curriculum Vitae</span>
        <span data-lang-only="en">Curriculum Vitae</span>
      </h2>
      <p class="mt-3 max-w-2xl text-sm text-body leading-relaxed">
        <span data-lang-only="es">Curriculum Vitae completo en PDF de 12 páginas. Descárgalo o ábrelo en una nueva pestaña para consultarlo.</span>
        <span data-lang-only="en">Complete 12-page Curriculum Vitae in PDF. Download it or open it in a new tab to review.</span>
      </p>
    </header>

    <div class="mt-8 flex flex-wrap gap-3">
      <a href={site.cvPdf} download={site.cvPdfDownloadName} class="btn-primary">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
          <polyline points="7 10 12 15 17 10"/>
          <line x1="12" y1="15" x2="12" y2="3"/>
        </svg>
        <span data-lang-only="es">{es.ui.cta.downloadCv}</span>
        <span data-lang-only="en">{en.ui.cta.downloadCv}</span>
      </a>
      <a href={site.cvPdf} target="_blank" rel="noopener" class="btn-ghost">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M14 3h7v7"/>
          <path d="M10 14L21 3"/>
          <path d="M21 14v5a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5"/>
        </svg>
        <span data-lang-only="es">Abrir en nueva pestaña</span>
        <span data-lang-only="en">Open in new tab</span>
      </a>
    </div>
  </div>
</section>
